{
  "name": "orbit-pos",
  "version": "1.0.0",
  "description": "Offline-First Desktop Point of Sale",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm run dev:react\" \"pnpm run dev:electron\" \"pnpm run dev:start\"",
    "dev:react": "vite",
    "dev:electron": "tsc -p electron/tsconfig.json -w",
    "dev:start": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "clean": "rimraf dist-electron dist-react release",
    "build": "pnpm run clean && pnpm run build:react && pnpm run build:electron && electron-builder",
    "build:win": "pnpm run clean && pnpm run build:react && pnpm run build:electron && electron-builder --win",
    "build:mac": "pnpm run clean && pnpm run build:react && pnpm run build:electron && electron-builder --mac",
    "build:react": "tsc && vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.2.1",
    "framer-motion": "^12.24.12",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "postcss": "^8.5.6",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  }
}
